{
    "name": "omni-search",
    "displayName": "Omni Search",
    "description": "Search for multiple strings sequentially in a file, with highlighting.",
    "version": "1.0.0",
    "publisher": "rajeshvasireddy",
    "repository": {
        "type": "git",
        "url": "https://github.com/rajvesh/vscode-sequential-search.git"
    },
    "bugs": {
        "url": "https://github.com/rajvesh/vscode-sequential-search/issues"
    },
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#667eea",
        "theme": "dark"
    },
    "keywords": [
        "search",
        "highlight",
        "find",
        "multi-cursor",
        "log analyzer",
        "query",
        "regex"
    ],
    "engines": {
        "vscode": "^1.87.0"
    },
    "categories": [
        "Other",
        "Visualization"
    ],
    "activationEvents": [
        "onView:omniSearchView"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "omni-search-container",
                    "title": "Omni Search",
                    "icon": "images/icon.png"
                }
            ],
            "panel": [
                {
                    "id": "omni-search-results-panel",
                    "title": "Omni Search Results",
                    "icon": "images/icon.png"
                }
            ]
        },
        "views": {
            "omni-search-container": [
                {
                    "type": "webview",
                    "id": "omniSearchView",
                    "name": "Queries",
                    "contextualTitle": "Omni Search"
                }
            ],
            "omni-search-results-panel": [
                {
                    "type": "webview",
                    "id": "omniSearchResultsView",
                    "name": "Results",
                    "contextualTitle": "Omni Search Results"
                }
            ]
        },
        "commands": [
            {
                "command": "omni-search.search",
                "title": "Omni Search"
            }
        ],
        "configuration": {
            "title": "Omni Search",
            "properties": {
                "omniSearch.savedQueries": {
                    "type": "array",
                    "default": [],
                    "description": "Saved queries with their colors and settings"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./node_modules/@vscode/test-electron/bin/test"
    },
    "devDependencies": {
        "@types/glob": "^7.1.4",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.28",
        "@types/vscode": "^1.87.0",
        "@vscode/codicons": "^0.0.35",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/webview-ui-toolkit": "^1.2.2",
        "glob": "^10.3.10",
        "mocha": "^10.3.0",
        "typescript": "^5.4.3"
    }
}
